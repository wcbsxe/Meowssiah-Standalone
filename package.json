{
  "name": "meowssiah-standalone",
  "version": "1.1.2",
  "private": true,
  "description": "Meowssiah 独立桌面写作工作台",
  "main": "app/electron.cjs",
  "author": "Local standalone adaptation; original preset: SoliUmbra",
  "scripts": {
    "prepare:data": "node scripts/prepare.cjs",
    "start": "electron .",
    "web": "node app/server.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win portable --x64",
    "build:runtime": "node scripts/build-runtime.cjs",
    "check:features": "node scripts/check-1.1.cjs"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "local.meowssiah.standalone",
    "productName": "Meowssiah",
    "asar": true,
    "directories": {
      "output": "dist-1.1.2"
    },
    "files": [
      "app/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraFiles": [
      {
        "from": "source/Meowssiah-2.0.9.original.json",
        "to": "original/Meowssiah-2.0.9.json"
      }
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "app/public/icon.ico"
    },
    "portable": {
      "artifactName": "Meowssiah-1.1.2-Windows-x64.exe"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "compare-versions": "6.1.1",
    "fast-json-patch": "3.1.1",
    "jquery": "3.7.1",
    "json5": "2.2.3",
    "jsonrepair": "3.15.0",
    "klona": "2.0.6",
    "lodash": "4.18.1",
    "mathjs": "12.4.3",
    "quickjs-emscripten": "0.32.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
